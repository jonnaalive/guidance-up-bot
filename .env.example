DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.1-flash-lite
SEC_USER_AGENT=Your Name your-email@example.com

# 기본값은 미국 상장사 전체의 최신 8-K, 6-K, 10-Q, 10-K입니다.
FORMS=8-K,6-K,10-Q,10-K
FEED_COUNT=100
POLL_MINUTES=15
MIN_CONFIDENCE=0.80

# 특정 종목만 볼 때만 입력: AAPL,MSFT,NVDA
WATCHLIST=

# Railway Volume을 /data에 마운트했다면 /data 사용
DATA_DIR=./data



